# Live model configuration (required for live generation)
MODEL_PROVIDER=openai
# Verified working id (lowercase; gpt-5.6-Luna returns 404)
MODEL_NAME=gpt-5.6-luna
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ElevenLabs configuration (required for narration)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Local process configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
ARTIFACT_ROOT=jobs
CONTENT_ROOT=content
PROMPT_ROOT=prompts
# Fast-output policy. Visual-model findings are logged but do not trigger rerenders;
# hard AST, render, sync, and clipping failures still get one repair attempt.
MAX_REPAIR_ATTEMPTS=1
VISUAL_REVIEW_BLOCKING=false
MANIM_COMMAND=manim
FFMPEG_COMMAND=ffmpeg
# Per Manim/FFmpeg subprocess, not per pipeline. A 100 second lesson renders at roughly
# 1.8x realtime at -qm, so 180 would risk killing a legitimate final render.
RENDER_TIMEOUT_SECONDS=420
