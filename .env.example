# Live model configuration (required for live generation)
MODEL_PROVIDER=openai
# Verified working id (lowercase; gpt-5.6-Luna returns 404)
MODEL_NAME=gpt-5.6-luna
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ElevenLabs configuration (required for narration)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Local process configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
ARTIFACT_ROOT=jobs
CATALOG_PATH=content/math/catalog.json
PROMPT_ROOT=prompts
FALLBACK_ROOT=fallback
ALLOW_HERO_FALLBACK=true
MANIM_COMMAND=manim
FFMPEG_COMMAND=ffmpeg
# Per Manim/FFmpeg subprocess, not per pipeline. A 100 second lesson renders at roughly
# 1.8x realtime at -qm, so 180 would risk killing a legitimate final render.
RENDER_TIMEOUT_SECONDS=420
